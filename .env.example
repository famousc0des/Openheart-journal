ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional. Speeds up YouTube transcription (speech-to-text).
# Claude cannot hear audio; Whisper/Groq turns speech into text, then Claude writes the notes.
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Optional. Native devices call this origin for /api/sermon/*.
# Leave unset to use the Expo bundler host from expo-constants.
# EXPO_PUBLIC_APP_ORIGIN=http://192.168.1.10:8081
