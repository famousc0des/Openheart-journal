rules_version = '2';

// Every piece of account data (journal, prayers, circles, profile fields,
// etc.) lives under users/{uid}/... and is only ever readable/writable by
// that account. Deploy with:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
